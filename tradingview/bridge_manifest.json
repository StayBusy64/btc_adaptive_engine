    "experimental_fields": {
      "signal_quality_score": {
        "layer": "research",
        "status": "candidate",
        "purpose": "Aggregated quality score used to compare release filtering decisions.",
        "description": "0-1 score that balances continuation support against contradiction and mean reversion risk."
      },
      "trend_slope_score": {
        "layer": "research",
        "status": "candidate",
        "purpose": "Measures whether slope acceleration supports the current signal side."
      },
      "continuation_confidence": {
        "layer": "research",
        "status": "candidate",
        "purpose": "Measures how much current trend, slope, volume, and RSI support follow-through."
      },
      "mean_reversion_risk": {
        "layer": "research",
        "status": "candidate",
        "purpose": "Flags stretched or rejection-prone entries that may revert instead of continue."
      },
      "regime_bias_score": {
        "layer": "research",
        "status": "candidate",
        "purpose": "Measures how favorable the current regime and price-vs-trend structure are for the signal side."
      },
      "contradiction_pressure": {
        "layer": "research",
        "status": "candidate",
        "purpose": "Measures how much near-term evidence contradicts the signal side."
      },
      "macro_bias_score": {
        "layer": "research",
        "status": "research",
        "purpose": "Reserved for future backend-informed macro bias feedback."
      },
      "cohort_alignment_score": {
        "layer": "research",
        "status": "research",
        "purpose": "Reserved for future cohort-conditioned feature promotion and demotion."
      }
    }
  },
  "decay_framework": {
    "recent_impulse": {
      "half_life_bars": 3,
      "contradiction_multiplier": 2.0,
      "refresh_signals": [
        "fresh displacement",
        "follow-through volume expansion",
        "confirmed continuation bar"
      ],
      "contradiction_signals": [
        "failed follow-through",
        "immediate opposite rejection",
        "below-trend acceptance"
      ],
      "floor": 0.0,
      "ceiling": 1.0
    },
    "recent_rejection": {
      "half_life_bars": 4,
      "contradiction_multiplier": 1.8,
      "refresh_signals": [
        "repeat wick rejection",
        "acceptance failure",
        "exhaustion confirmation"
      ],
      "contradiction_signals": [
        "clean trend continuation",
        "value acceptance in signal direction"
      ],
      "floor": 0.0,
      "ceiling": 1.0
    },
    "regime_bias": {
      "half_life_bars": 24,
      "contradiction_multiplier": 2.4,
      "refresh_signals": [
        "persistent trend stack",
        "session-level continuation success",
        "aligned higher-timeframe bias"
      ],
      "contradiction_signals": [
        "opposite rejection cluster",
        "trend collapse",
        "chop transition"
      ],
      "floor": 0.0,
      "ceiling": 1.0
    },
    "session_bias": {
      "half_life_bars": 16,
      "contradiction_multiplier": 2.0,
      "refresh_signals": [
        "same-session continuation success",
        "opening drive confirmation"
      ],
      "contradiction_signals": [
        "session reversal",
        "opening drive failure"
      ],
      "floor": 0.0,
      "ceiling": 1.0
    }
  },
